# Base de données
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/adcognita"

# JWT
JWT_SECRET="changez-ce-secret-en-production-minimum-64-caracteres"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="changez-ce-refresh-secret-en-production-minimum-64-caracteres"
JWT_REFRESH_EXPIRES_IN="7d"

# Serveur
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

# Email (SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="contact@adcognita.fr"
SMTP_PASS="votre-mot-de-passe-smtp"
EMAIL_FROM="Ad Cognita <contact@adcognita.fr>"

# Upload fichiers
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# Admin par défaut (seed)
ADMIN_EMAIL="admin@adcognita.fr"
ADMIN_PASSWORD="changez-ce-mot-de-passe"
